{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "publish-file",
            "type": "shell",
            "command": ".vscode\\publishfile.cmd ${file}"
        },
        {
            "label": "publish-blog-emacs",
            "type": "shell",
            "command": "emacs -batch -script .vscode/init.el -eval '(org-static-blog-publish)'",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish-blog-py",
            "type": "shell",
            "command": ".venv/bin/python3 bsbr.py",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}